{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RPK Studio",
  "version": "2.1.0",
  "identifier": "io.github.hrk666666.rpkstudio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RPK Studio",
        "width": 440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
